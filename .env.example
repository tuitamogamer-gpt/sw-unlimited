# Optional Google sign-in. Guest play works without these values.
# Create a Google OAuth web client. Local callback:
# http://localhost:5173/api/auth/callback/google
AUTH_URL=http://localhost:5173
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate a separate secret: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Optional stable local game checkpoint key (at least 32 characters).
# Keep this separate from AUTH_SECRET. Production already has its own key.
# SWU_SESSION_SECRET=

# Optional Supabase accounts and cloud saves. Run supabase/accounts.sql first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY= # Legacy public key alternative.
# Server-only; never use a VITE_ prefix for this credential.
SUPABASE_SERVICE_ROLE_KEY=
# Enable only after configuring the Google provider in Supabase.
SUPABASE_GOOGLE_ENABLED=false
