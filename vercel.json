{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run engine:setup && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,data/**,vendor/forceteki/build/server/**,vendor/forceteki/test/json/**}",
      "excludeFiles": "{docs/**,tests/**,scripts/**,vendor/forceteki/{server,docs,scripts,.github,.claude,build/test,test/{server,scenarios,helpers,gameSetups}}/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
