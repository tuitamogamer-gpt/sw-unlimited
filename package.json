{
  "name": "star-wars-unlimited-command",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.cjs",
    "engine:setup": "node scripts/setup-engine.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node scripts/ui-regression.mjs",
    "test:custom-ui": "node scripts/custom-decks-ui.mjs",
    "test:motion-ui": "node scripts/battle-motion-ui.mjs",
    "test:preview-ui": "node scripts/opponent-preview-ui.mjs",
    "test:ambush-hover-ui": "node scripts/ambush-hover-ui.mjs",
    "test:damage-ui": "node scripts/damage-presentation-ui.mjs",
    "test:menu-ui": "node scripts/menu-selections-ui.mjs",
    "test:account-ui": "node scripts/account-ui.mjs",
    "test:guidance-ui": "node scripts/play-guidance-ui.mjs",
    "test:hand-ui": "node scripts/hand-fan-ui.mjs",
    "test:storage-ui": "node scripts/storage-recovery-ui.mjs",
    "test:training-ui": "node scripts/training-ui.mjs",
    "test:review-ui": "node scripts/match-review-ui.mjs",
    "test:cloud-ui": "node scripts/account-cloud-ui.mjs",
    "test:smoke": "node scripts/smoke.cjs",
    "cards:check": "node scripts/report-coverage.cjs",
    "cards:catalog-check": "node scripts/sync-card-catalog.cjs --check",
    "cards:sync": "node scripts/sync-card-catalog.cjs",
    "cards:refresh": "node scripts/sync-card-catalog.cjs --refresh",
    "test:online-ui": "node scripts/online-play-ui.mjs"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "@supabase/supabase-js": "^2.117.3",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
